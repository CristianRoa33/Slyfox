---
import Hero from '@components/sections/hero/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Containertitle from '@components/sections/containerImage/Container-title.astro';
import Banner from '@components/sections/containerImage/Banner.astro';
import Cards_Mobile from '@components/sections/cards/Cards-mobile.astro';
import Cards from '@components/sections/cards/Cards.astro';
import Cards_Servicios from '@components/sections/cards/Cards-servicios.astro';
import TeamServices from '@components/sections/teamServices/Team-services.astro';
import { tarjetas } from "@components/information-cards.astro"


// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <Hero />
    <Containertitle />
    <Banner />
    <Cards_Mobile />
    <Cards/>
    <Cards_Servicios tarjetas = {tarjetas}/>
    <TeamServices/>
</Layout>   