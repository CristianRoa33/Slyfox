---
import Logo from "@components/Shared/Logo.astro";
import DarkMode from '@components/sections/nav/Darkmode.astro';
import Conocenos from "@components/Shared/buttonConocenos.astro"


const links = [
    {name: 'Inicio', href: '/'},
    {name: 'Nuestro Equipo', href: '#'},
    {name: 'Servicios', href: '/contact'}, 
    ]
---
<header 
    class="w-full bg-[#fbfbfb] dark:bg-[#000000] "
>
    <nav 
        class="w-full h-full flex items-stretch mt-2 md:flex md:justify-around md:h-30 lg:h-56 2xl:flex 2xl:justify-evenly"
    >
        <div class="m-3 md:ml-10 "
        >
            <Logo with="99px"/>
        </div>
            <ul 
                class="hidden md:flex md:gap-5 md:items-stretch md:mt-3 md:text-[14px] md:ml-25
                md:font-segoe md:text-[#1E1E1E] md:dark:text-[#ffffffeb] lg:ml-20 lg:flex lg:justify-center lg:items-stretch xl:flex xl:justify-center xl:items-stretch xl:ml-35 2xl:flex 2xl:justify-center 2xl:items-stretch 2xl:mt-4 2xl:ml-45"
            >
                {links.map(link => (
                    <li>
                        <a href={link.href}
                        >
                        {link.name}
                        </a>
                    </li>
                ))}
                
            </ul>
            <div 
                class="hidden md:flex mt-3 2xl:mt-4
                "
            >
                <Conocenos /> 
            </div>
        <div class="mt-3 ml-auto md:ml-1 md:mt-4 lg:ml-0"
        >
            <DarkMode />
        </div>
            <button 
                id="menuButton" 
                class=" flex w-10 h-10 space-x-4 p-3 font-bold  text-[#1E1E1E] dark:text-[#ffffffeb] 
                bg-[#fbfbfb] dark:bg-[#000000] md:hidden lg:hidden"
            >
                ☰
            </button>
    </nav>
<header/>   

<style>
    a {
        transition: all 0.5s ease-in-out;
        position: relative;
    }
    a:hover {
        color: #FF7070;
    }
    a::after {
        content: '';
        display: block;
        position: absolute;
        width: 0%;
        height: 2px;
        background: #FF7070;
        transition: all 0.3s ease-in-out;
        scale: 0;
        bottom: -15px;
        
    }
    a:hover::after {
        width: 100%;
        scale: 1;
    }

</style>