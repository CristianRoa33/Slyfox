---
import Image from "astro/components/Image.astro";
import Zorro from "@images/zorro.webp";

const faqs = [
    {
    id: "respuesta1",
    question: "¿Qué servicios ofrece SlyFox?",
    answer: "SlyFox ofrece una amplia gama de servicios digitales que incluyen diseño UI/UX, desarrollo web, desarrollo móvil y de aplicaciones, así como soluciones de software a medida."
    },
    {
    id: "respuesta2",
    question: "¿Qué nos hace únicos en comparación con otras empresas de diseño y desarrollo?",
    answer: "En SlyFox, nos destacamos por nuestra combinación de diseño UI excepcional y desarrollo web de vanguardia. Nuestro enfoque integrado nos permite ofrecer soluciones digitales completas que no solo son visualmente impresionantes, sino también altamente efectivas en la generación de resultados"
    },
    {
    id: "respuesta3",
    question: "¿Cómo funciona el proceso de trabajo con SlyFox?",
    answer: "Nuestro proceso comienza con una consulta inicial donde discutimos tus necesidades y objetivos. A partir de ahí, nuestro equipo trabaja estrechamente contigo en cada etapa del proyecto, desde la conceptualización y el diseño hasta el desarrollo y la implementación. Nos esforzamos por mantener una comunicación abierta y transparente en todo momento para garantizar que tus expectativas se cumplan."
    },
    {
    id: "respuesta4",
    question: "¿Qué tipo de garantías ofrecen en sus servicios?",
    answer: "En SlyFox, respaldamos la calidad de nuestros servicios con una sólida garantía. Esto incluye garantías de satisfacción en el diseño UI/UX, así como garantías de funcionamiento y rendimiento en el desarrollo web y móvil. Si algo no está a la altura de tus expectativas, nos comprometemos a corregirlo rápidamente y sin costo adicional para ti."
    },
    {
    id: "respuesta5",
    question: "¿Qué tipo de soporte ofrecen después del lanzamiento del proyecto?",
    answer: "Nuestro compromiso con tu éxito no termina con el lanzamiento del proyecto. SlyFox ofrece servicios de mantenimiento continuo y soporte técnico las 24 horas del día, los 7 días de la semana, para garantizar que tu sitio web o aplicación funcione de manera óptima en todo momento y esté protegido contra cualquier problema técnico que pueda surgir."
    },
];
---
<section class="w-full h-auto flex justify-center bg-[#F5F6FA] dark:bg-[#0D0D0D] p-1 mt-15 ">
    <div class="bg-[#fbfbfb] rounded-2xl m-8 pb-8 md:flex md:flex-row-reverse md:items-start md:bg-[#FFFFFF] md:w-[85%] lg:w-[70%] 
    xl:w-[60%] 2xl:mb-20">
        <div class="flex md:hidden">
            <Image 
                src={Zorro} 
                alt="" 
                class="object-contain max-w-[30px] mt-5 ml-3 sm:ml-7"
            />
            <h1 class="text-[#15242F] text-[15px] font-bold font-satoshi">
                <span class="text-[#FF7070]">Preguntas?</span> <br>
                Respuestas.
            </h1>
        </div>
        <div class="md:flex md:flex-col md:mt-5 md:w-[120%]">
        {faqs.map(({ id, question, answer }, index) => (
            <div class="w-[90%] border-b border-gray-300 mx-auto">
                <button
                    class="w-full px-4 py-3 text-left text-[10px] font-satoshi text-[#15242F] bg-[#fbfbfb] flex justify-between items-center sm:text-[12px]  
                    md:mt-2 md:bg-[#FFFFFF] md:text-[10px] xl:text-[15px]"
                    onclick={`document.getElementById('${id}').classList.toggle('hidden'); document.getElementById('flecha${index}').classList.toggle('rotate-180')`}
                >
                    {question}
                    <svg class="w-5 h-5 transform transition-transform duration-200 ml-0" id={`flecha${index}`} viewBox="0 0 20 20" fill="currentColor">
                        <path d="M5.25 7.5L10 12.25L14.75 7.5H5.25Z" />
                    </svg>
                </button>
                <div id={id} class="px-4 py-3 text-[12px] hidden bg-white text-gray-700 sm:text-sm">
                    {answer}
                </div>
            </div>
        ))}
        </div>
        <div class=" flex flex-col justify-center items-center bg-[#F5F6FA] max-w-[350px] rounded-2xl mt-5 mx-5 p-4 sm:max-w-[460px] sm:h-60 sm:ml-12 md:md:bg-[#FFFFFF] md:flex md:items-center md:mt-5 md:p-2">
            <div>
            <h1 class= " hidden md:block md:text-[#15242F] md:text-[30px] md:font-bold md:font-satoshi md:mt-10 xl:text-[35px] xl:mt-40 ">
                <span class="text-[#FF7070]">Preguntas?</span> <br>
                Respuestas.
            </h1>
            </div>
            <div class=" rounded-full w-12 h-12  bg-[#FFFFFF] flex justify-center items-center sm:mt-5">
                <Image 
                    src={Zorro} 
                    alt="zorro" 
                    class="object-contain w-[30px] h-[30px]"
                />
            </div>
            <h3 class="text-[12px] text-center mt-5 sm:mt-10 sm:text-sm md:text-[15px]">Soy Un ser Humano como tú ¡ Pregúntame Cualquier cosa!</h3>
            <div class="flex justify-center bg-[#FFFFFF] mt-5 w-[100%] h-[40px] text-center rounded-2xl p-2 border-1 border-gray-300 font-bold font-satoshi shadow-2xs sm:mt-10 sm:text-sm md:w-[90%] md:h-[20%] md:text-[10px] xl:text-[15px] xl:mb-15 2xl:mb-35">
                <a href="" class="text-center">Contáctenos</a>
            </div>
        </div>
        
    </div>
</section>

