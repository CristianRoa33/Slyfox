---
import { Image } from 'astro:assets';
import Star from "@images/Star.png";
const imagenStar= Array.from({length:5})
---
<div 
    id="stars"
    class="flex gap-x-0.5 mt-4 mr-18  sm:mr-31 sm:mt-8 md:ml-2"
>
    {imagenStar.map((_ , index ) =>(
        <Image 
            src={Star} 
            alt={"star" + (index + 1) } 
            id={"star" + (index + 1) } 
            class="w-3 h-3 mt-1 xl:w-5 xl:h-5" 
        />
    ))}
</div>

<style>
#star1 {
    animation:pulsate-bck 10s ease-in-out infinite ;
}
#star2 {
    animation:pulsate-bck 8s ease-in-out infinite ;
}
#star3 {
    animation:pulsate-bck 6s ease-in-out infinite ;
}
#star4 {
    animation:pulsate-bck 4s ease-in-out infinite ;
}
#star5 {
    animation:pulsate-bck 2s ease-in-out infinite ;
}
@keyframes pulsate-bck {
    0%{opacity:0;} 
    50%{opacity:1;}
    100%{opacity:2;}
}
</style>

<script>
    window.addEventListener('DOMContentLoaded', ()=> {
        const starsContainer = document.getElementById('stars');
        const starElements= Array.from ({length:5}, (_,index) => 
            document.getElementById(`star${index + 1}`)
        ).filter((star): star is HTMLElement => star !== null);

        const observer = new IntersectionObserver ((entries)=> {
            entries.forEach((entry )=> {
                if(entry.isIntersecting){
                    starElements.forEach((star,index)=> {
                    star.style.animation='none';
                    void star.offsetWidth; // Forzar reflujo para reiniciar la animación
                    const durations = [10, 8, 6, 4, 2];
                    star.style.animation = `pulsate-bck ${durations[index]}s ease-in-out infinite`;
                })
                } else {
                starElements.forEach((star) => {
                    star.style.animation = 'none'; 
                });
            }
    })
} , {
        threshold: 0.4 // El elemento debe estar al menos 40% visible
    })
        if(starsContainer) {
        observer.observe(starsContainer);
    }
    });
</script>
