---
import { Image } from "astro:assets";
import Image170 from "@images/image170.png"
import Image171 from "@images/image171.png"
import Image172 from "@images/image172.png"
import Image169 from "@images/image169.png"
import Image173 from "@images/image173.png"
import Image174 from "@images/image174.png"

const imagenes = [
    { src: Image170 , alt:"Image170", title: "Image170",  },
    { src: Image171 , alt:"Image171", title: "Image171", },
    { src: Image172 , alt:"Image172", title: "Image172", },
    { src: Image169 , alt:"Image169", title: "Image169", },
    { src: Image173 , alt:"Image173", title: "Image173", },
    { src: Image174 , alt:"Image174", title: "Image174", },

]
---
<div 
    class="phones grid grid-cols-6 p-6 w-full bg-[#fbfbfb] dark:bg-[#000000] gap-2 sm:p-9 
    lg:p-12 xl:p-18 2xl:p-25"
>
    {imagenes.map((imagen, index)=>(
        <Image 
            src={imagen.src} 
            alt={`imagen ${index + 1}`}
            class = {` transform 
                        ${index === 0? 'translate-y-11 animate-Image170':''}
                        ${index === 1? 'translate-y-8 animate-Image171':''}
                        ${index === 2? 'translate-y-5 animate-Image172':''}
                        ${index === 3? 'translate-y-3 animate-Image169':''}
                        ${index === 4? 'translate-y-1 animate-Image173':''} 
                        ${index === 5? 'translate-y-1 animate-Image174':''}
                    `} 
        />
    ))}
</div>

<style>

    .animate-Image170 {
    animation: reveal ;
    animation-duration : 1s ;
    animation-timing-function: ease-out ;

    
    }
    
    .animate-Image171 {
    animation: reveal ;
    animation-duration : 2s ;
    animation-timing-function: ease-out ; 
   
    
    }
    .animate-Image172 {
    animation: reveal ;
    animation-duration : 3s ;
    animation-timing-function: ease-out ; 
    
    
    }

    .animate-Image169 {
    animation: reveal ;
    animation-duration : 4s ;
    animation-timing-function: ease-out ; 
    
    }

    .animate-Image173 {
    animation: reveal ;
    animation-duration : 5s ;
    animation-timing-function: ease-out ; 
    
    }

    .animate-Image174 {
    animation: reveal ;
    animation-duration : 6s ;
    animation-timing-function: ease-out ; 
    
    }


  @keyframes reveal {
    0% {
    transform: translateY(100px);
    opacity: 0;
    }
    50 % {
    transform: translateY(50px);   
    opacity: .4; 
    }
    100% {
    transform: translateY(0);
    opacity: 1;
    }
}
</style>