---
import { Image } from 'astro:assets';
import customer1 from "src/assets/images/customer1.webp";
import customer2 from "@images/customer2.webp";
import customer3 from "@images/customer3.webp";
import customer4 from "@images/customer4.webp";
import customer5 from "@images/customer5.webp";

const imageCostumer=[
    {src: customer1 , alt: "customer1", id: "customer1"},
    {src: customer2 , alt: "customer2", id: "customer2"},
    {src: customer3 , alt: "customer3", id: "customer3"},
    {src: customer4 , alt: "customer4", id: "customer4"},
    {src: customer5 , alt: "customer5", id: "customer5"}
]
---
<div 
    class="flex gap-x-0.5 mt-4 sm:mt-9 sm:ml-20"
>
    {imageCostumer.map((customer, index)=> (
        <Image 
            src = {customer.src}
            alt = {`customer ${index + 1}`} 
            id  = {`customer ${index + 1}`} 
            width = {400}
            height = {300}
            class = {`w-7 h-7 sm:w-9 sm:h-9 md:w-10 md:h-10 lg:w-11 lg:h-11 xl:w-12 xl:h-12 transform 
                        ${index === 0? 'translate-x-11 animate-customer1':''}
                        ${index === 1? 'translate-x-8 animate-customer2':''}
                        ${index === 2? 'translate-x-5 animate-customer3':''}
                        ${index === 3? 'translate-x-3 animate-customer4':''}
                        ${index === 4? 'translate-x-1 animate-customer5':''} 
                    `} 
        />
    ))}
</div>
<style>

.animate-customer1 {
    animation: slideIn ;
    animation-duration : 1s ;
    animation-timing-function:  ease-out ; 
    animation-iteration-count: forwards;
}
.animate-customer2 {
    animation: slideIn ;
    animation-duration : 1.2s ;
    animation-timing-function:  ease-out ; 
    animation-fill-mode: forwards;
}
.animate-customer3 {
    animation: slideIn ;
    animation-duration : 1.4s ;
    animation-timing-function:  ease-out ; 
    animation-fill-mode: forwards;
}
.animate-customer4 {
    animation: slideIn ;
    animation-duration : 1.6s ;
    animation-timing-function:  ease-out ; 
    animation-fill-mode: forwards;
}
.animate-customer5 {
    animation: slideIn ;
    animation-duration : 1.8s ;
    animation-timing-function:  ease-out ; 
    animation-fill-mode: forwards;
}
.animate-customer6 {
    animation: slideIn ;
    animation-duration : 1.10s ;
    animation-timing-function:  ease-out ; 
    animation-fill-mode: forwards;
}
    
@keyframes slideIn {
    0% {
    transform: translateX(200px);
    opacity: 0;
    }
    100% {
    transform: translateX(0);
    opacity: 1;
    }
}

</style>
