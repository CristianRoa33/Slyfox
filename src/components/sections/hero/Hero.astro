---
import Logo from "@components/Shared/Logo.astro";
import Image from "astro/components/Image.astro";
import Probeta from "@images/Probeta.webp"
import Mandarina from "@images/Mandarina.webp";
import Patilla from "@images/Patilla.webp";
import Bomba from "@images/Bomba.webp";
import Uvas from "@images/Uvas.webp";
import Hongo from "@images/Hongo.webp";
import ProbetaRoja from "@images/ProbetaRoja.webp";
import Rayo from "@images/Rayo.webp";

---

<div class="w-full h-80 flex justify-center  sm:h-100 bg-[#F5F6FA] dark:bg-[#0D0D0D]  md:h-120 lg:h-200">
  <div
    class="relative flex flex-col items-center justify-center text-center px-2.5 sm:px-16  lg:py-[80px] 2xl:px-[400px] py-10 sm:py-10 2xl:py-[100px]"
  >
      <Logo className=" w-[90px] sm:w-[120px] md:w-[130px] lg:w-[170px] xl:w-[230px] 2xl:w-[220px]"/>
    <div class="hidden box_fruit absolute md:block md:top-10 md:left-45 lg:top-25 lg:left-60 xl:top-18 xl:left-75 2xl:top-20 2xl:left-125 ">
    <Image
      src={Probeta} alt="Probeta" class="fruit md:w-[25px] lg:w-[35px] xl:w-[45px] 2xl:w-[50px] "/> 
    </div>
    <div class="hidden box_fruit absolute md:block md:top-25 md:left-135 lg:top-45 lg:left-185 xl:top-35 xl:left-250 2xl:top-40 2xl:left-325 ">
      <Image
      src={Mandarina} alt="Mandarina" class="fruit md:w-[35px] lg:w-[45px] xl:w-[55px] 2xl:w-[65px] "/>
    </div>
    <div class="hidden box_fruit absolute md:block md:top-53 md:left-30 md:rotate-180 lg:top-100 lg:left-25 xl:top-90 xl:left-45 2xl:top-90 2xl:left-90 ">
      <Image
      src={Patilla} alt="Patilla" class="fruit md:w-[25px] lg:w-[35px] xl:w-[45px] 2xl:w-[50px] "/>
    </div>
    <div class="hidden box_fruit absolute md:block md:top-30 md:left-8 md:rotate-250 lg:top-60 2xl:top-60 2xl:left-25 0 ">
      <Image
      src={Bomba} alt="Bomba" class="fruit md:w-[45px] lg:w-[55px] xl:w-[65px] 2xl:w-[75px] "/>
    </div>
    <div class="hidden box_fruit  absolute md:block md:top-12 md:left-170 md:rotate-45 lg:top-27 lg:left-220 xl:top-15 xl:left-320 2xl:top-20 2xl:left-400  ">
      <Image
      src={Uvas} alt="Uvas" class="fruit md:w-[25px] lg:w-[35px] xl:w-[45px] 2xl:w-[50px] "/>
    </div>
    <div class="hidden box_fruit absolute md:block md:top-100 md:left-17 lg:top-170 xl:top-175 xl:left-20 2xl:top-160 2xl:left-45 ">
      <Image
      src={Hongo} alt="Hongo" class="fruit md:w-[35px] lg:w-[45px] xl:w-[55px] 2xl:w-[60px] "/>
    </div>
    <div class="hidden box_fruit absolute md:block md:top-105 md:left-90 lg:top-180 lg:left-120 xl:top-182 xl:left-160 2xl:top-180 2xl:left-220 ">
      <Image
      src={ProbetaRoja} alt="ProbetaRoja" class="fruit md:w-[30px] lg:w-[40px] xl:w-[50px] 2xl:w-[50px] "/>
    </div>
    <div class="hidden box_fruit absolute md:block md:top-85 md:left-180 md:rotate-45 lg:top-140 lg:left-240 xl:top-145 xl:left-340  2xl:top-130 2xl:left-420">
      <Image
      src={Rayo} alt="Rayo" class="fruit md:w-[25px] lg:w-[35px] 2xl:w-[40px] "/>
    </div>
    <h1
      class="text-base sm:text-3xl lg:text-6xl lg:mt-30
            text-[#31323D] dark:text-[#F5F5F7]
            font-extrabold font-satoshi
            mt-5 sm:mt-16 xl:mt-28
            mb-2 sm:mb-10 xl:mb-20 ">
            Transformamos Ideas<br />en Experiencia<span
        class="text-[#FF7070] inline-block title-dot">.</span>
    </h1>
    <h2 class="text-[15px] sm:text-sm md:text-lg font-bold text-[#36455d] dark:text-[#86868B] lg:hidden"
    >
      Software a la medida optimizado para SEO. Creamos aplicaciones web y móviles rápidas, escalables y visibles en buscadores. Potencia tu negocio con soluciones que combinan rendimiento, experiencia de usuario y conversión digital.
    </h2>
    <h2 
      class="hidden w-[80%] lg:block lg:text-[15px] xl:text-[20px] font-bold text-[#131b27] dark:text-[#86868B]"
    >
      Desarrollamos software a la medida optimizado para SEO, asegurando alto rendimiento, escalabilidad y visibilidad en buscadores. Creamos aplicaciones web y móviles con código limpio y estrategias de optimización, mejorando velocidad de carga, experiencia de usuario (UX) y posicionamiento en Google. Implementamos arquitectura eficiente, desarrollo responsivo y técnicas avanzadas como SEO técnico, indexación optimizada y estrategias de conversión digital. Potencia tu negocio con soluciones tecnológicas que no solo funcionan, sino que también destacan en el mercado digital.
    </h2>
  </div>
</div>

<style>

  .title-dot.animate {
    animation: enterdot 1s cubic-bezier(0, 0.9, 0.12, -0.06) both;
  }
  .fruit{
    animation: rotate-fruit 100s infinite linear both alternate;
}

.box_fruit{
    z-index: 110 !important;
    position: absolute;
    will-change: transform;
    animation: move-fruit 20s infinite linear both alternate;
}

@-moz-keyframes move-fruit {
    100% { -moz-transform: translate(-100px, -100px);}
}
@-webkit-keyframes move-fruit {
    100% { -webkit-transform: translate(-100px, -100px);}
}
@keyframes move-fruit{
    100% { -webkit-transform: translate(-100px, -100px); transform:translate(-100px, -100px); }
}
@-moz-keyframes rotate-fruit {
    100% { -moz-transform: rotate(-720deg);}
}
@-webkit-keyframes rotate-fruit {
    100% { -webkit-transform: rotate(-720deg);}
}
@keyframes rotate-fruit{
    100% { -webkit-transform: rotate(-720deg); transform:rotate(-720deg); }
}



  @keyframes enterdot {
    0% {
      transform: translateY(-100vh); /* Comienza fuera de la pantalla */
    }

    40% {
      transform: translateY(0); /* Llega a la posición final */
    }

    50% {
      transform: translateY(
        -30px
      ); /* Primer rebote hacia arriba (más grande) */
    }

    60% {
      transform: translateY(15px); /* Rebote hacia abajo (más pronunciado) */
    }

    70% {
      transform: translateY(-10px); /* Rebote hacia arriba más pequeño */
    }

    80% {
      transform: translateY(5px); /* Rebote más pequeño aún */
    }

    90% {
      transform: translateY(-2px); /* Último rebote muy pequeño */
    }

    100% {
      transform: translateY(0); /* Termina en su posición final */
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const titleDot = document.querySelector('.title-dot');
    
    if (titleDot) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            observer.unobserve(entry.target); // Opcional: desconectar después de animar
          }
        });
      }, {
        threshold: 0.1, // El elemento debe estar al menos 10% visible
        rootMargin: '0px 0px -50px 0px' // Opcional: ajustar el margen
      });

      observer.observe(titleDot);
    }
  });
</script>