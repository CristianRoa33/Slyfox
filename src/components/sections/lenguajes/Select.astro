---
import { Icon } from "astro-icon/components";

const options = ["Español", "Ingles"];
---

<div class=" md:w-64 md:relative lg:w-64 lg:relative md:text-xs md:py-0.5 md:px-1">
  <select class="slf-select font-segoe ">
    {
      options.map((option) => (
        <option value={option} class="dark:bg-[#282829] font-segoe ">
          {option}
        </option>
      ))
    }
  </select>

  <div
    class=" md:absolute md:inset-y-5 md:right-5 md:text-xs md:flex md:items-center md:h-0.5 md:py-0.1 md:px-1 lg:absolute lg:inset-y-5 lg:right-4 lg:px-2 lg:text-2xl lg:flex lg:items-center Lg:pointer-events-none text-[#31323D] dark:text-[#ffffffeb]">
    <Icon name="down-arrow" />
  </div>
</div>

<style>
  @reference "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  .slf-select {
    @apply cursor-pointer w-full px-4 py-2 pr-8 leading-tight text-[#31323D] dark:text-[#ffffffeb]  rounded-xl border-3 border-[#FF7070] dark:border-[#282829] shadow appearance-none focus:outline-none;
  }
</style>
