---
import Image from "astro/components/Image.astro"
import corazon from "@images/"

---
<section  class="bg-[#fbfbfb] dark:bg-[#282829]">
    <div class="mt-10 ml-8 w-[80%] bg-amber-400">
        <h1 class="text-[15px] ml-5">
            Lo que nos diferencia es que lo hacemos con amor.
        </h1>
    </div>
    <div>
        <Image 
            src={corazon} 
            alt="" 
            class="object-contain w-[30px] h-[30px]"
        />
    </div>
    
</section>

