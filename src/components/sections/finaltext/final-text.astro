---
import Image from "astro/components/Image.astro"
import corazon from "@images/corazon.png"
import Conocenos from "@components/Shared/buttonConocenos.astro"

---
<section  class="bg-[#fbfbfb] dark:bg-[#000000] w-full h-full flex justify-center ">
    <div class="w-full flex flex-col items-center justify-center mt-8 sm:mt-10 lg:mt-12">
    <div class="w-[90%] font-bold font-satoshi text-[18px] text-center sm:text-[25px] md:text-[28px] md:w-[80%] lg:text-[30px]">
        <p class="dark:text-[#F5F5F7] text-[#31323D] sm:text-2xl md:text-[35px] lg:text-[45px] xl:text-[55px] 2xl:text-[75px] ">
            Lo que nos <span class="text-[#FF7070]">diferencia</span> es que lo
        </p>
        <p class="dark:text-[#F5F5F7] text-[#31323D] sm:text-2xl md:text-[35px] lg:text-[45px] xl:text-[55px] 2xl:text-[75px] ">
            <span class="text-[#FF7070]">hacemos</span> con <span class="text-[#FF7070]">amor</span>
        </p>
    </div>
    <div class="flex justify-center mt-5 sm:mt-10 md:mt-15 lg:mt-20">
        <Image 
            src={corazon} 
            alt="corazon" 
            class="heart object-contain w-[30px] h-[30px] sm:w-[40px] sm:h-[40px] md:w-[60px] md:h-[60px] lg:w-[60px] lg:h-[60px] xl:w-[80px] xl:h-[80px] "
        />
    </div>
    <div class="flex justify-center mt-5 sm:mt-10 md:mt-15 md:mb-15 lg:mt-20 2xl:mb-30">
            <Conocenos  className="rounded-md font-segoe w-[120px] h-8 text-sm text-[#F5F5F7] bg-[#5137F0] sm:w-[160px] sm:h-[35px] sm:text-[18px] md:w-[100px] md:h-7 md:text-[12px] md:rounded-2xl lg:w-[120px] lg:text-[15px] lg:font-light lg:h-8 xl:text-[17px] xl:w-[140px] xl:h-9 2xl:w-[160px] 2xl:h-10 2xl:text-[19px]" / > 
    </div>  
    </div>      
</section>

<style>
.heart {
    clip-path:none(50% 0% , 100% 35%,80% 100%,50% 80% ,20% 100%,0% 35%);
    animation: heartbeat 1s infinite;
    transform-origin: center ;
}
@keyframes heartbeat { 
    0%, 100% {
        transform: scale(1) ;
    }
    25% {
        transform: scale(1.2) ;
    }
    50% {
        transform: scale(1) ;
    }
    75 % {
        transform: scale (1.1);
    }
}

</style>