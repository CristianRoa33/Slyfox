---
const { tarjetas = [] } = Astro.props;
import { Image } from "astro:assets";


const titulo = "Descubre más de tu compañero perfecto."

---
<section class="w-full h-full bg-[#fbfbfb] dark:bg-[#000000] mt-8 xl:mt-40"> 
    <div class= "w-[280px] p-3 xl:w-160 xl:ml-10">
        <h2 class="text-[#1E1E1E] dark:text-[#ffffffeb] font-satoshi ml-6 p-1 text-[15px] md:mt-15 lg:text-xl xl:text-[42px]">
            {titulo}
        </h2>
    </div>
    
<div id="carousel"
    class="bg-[#fbfbfb] dark:bg-[#000000] parent overflow-auto scrollbar-hide no-scrollbar snap-x p-3 ease-linear lg:overflow-hidden lg:p-4 xl:p-6 2xl:p-8">
    {tarjetas.map((tarjeta) => (
        <div class="snap-center">
            <div class="bg-[#f5f6f9] dark:bg-[#0D0D0D] card overflow-hidden w-[240px] h-[220px] md:h-[300px] lg:w-[190px] lg:h-[320px] xl:w-[250px] xl:h-[360px] 2xl:w-[350px] 2xl:h-[450px]">
                <Image src={tarjeta.src} alt={tarjeta.titulo} class="w-20 md:w-25 xl:w-30" /></div>
            <h3 class="text-[#1E1E1E] dark:text-[#ffffffeb] flex justify-start font-satoshi font-bold mt-2 ml-1.5 text-sm sm:text-base sm:ml-1 md:text-[13px]  md:ml-1 md:mt-3 lg:text-[10px] xl:text-[15px] ">{tarjeta.titulo}</h3>
            <p class="text-[#86868b] dark:text-[#86868B] font-satoshi font-bold text-left text-sm p-2 sm:text-base sm:p-1 md:text-[12px]  lg:text-[10px] md:p-1 xl:text-[15px] xl:mb-5">{tarjeta.descripcion}</p>
            <ul class="list-disc p-5 space-y-1">
                {tarjeta.items.map((item) => (
                    <li class="text-[#86868b] dark:text-[#86868B] font-satoshi text-sm ml-4 sm:text-base md:text-[13px] md:ml-1 lg:text-[10px] xl:text-[15px] ">{item}</li>
                ))}
            </ul>
        </div>
    ))} 
</div>
    </div>
        <div class="flex justify-center mt-2 gap-x-8 mb-15 md:flex md:justify-end md:mr-10 md:mb-5">
        <button id="prev" class="flex items-center w-10 bg-[#333336] text-white p-2 rounded-full">
            ❮
        </button>
        <button id="next" class="flex items-center w-10 bg-[#333336] text-white p-2 rounded-full">
            ❯
        </button>
    </div>

</section>     

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
    const carousel = document.getElementById("carousel");
    const nextBtn = document.getElementById("next");
    const prevBtn = document.getElementById("prev");

    // Define el ancho de cada tarjeta (ajústalo si cambia el diseño)
    const cardWidth = 260; // 240px tarjeta + 20px gap aproximadamente

    let scrollPosition = 0;

    function isMobile() {
    return window.innerWidth < 1024;
    }

    function updateScrollButtons() {
        if (isMobile()) {
            nextBtn.style.display = "inline-block";
            prevBtn.style.display = "inline-block";
        } else {
        nextBtn.style.display = "none";
        prevBtn.style.display = "none";
        carousel.scrollTo({ left: 0 }); // Resetea la posición si es necesario
        scrollPosition = 0;
    }
    }
    nextBtn.addEventListener("click", () => {
        if (!isMobile()) return;
            scrollPosition += cardWidth;
            carousel.scrollTo({ left: scrollPosition, behavior: "smooth" });
    });

    prevBtn.addEventListener("click", () => {
        if (!isMobile()) return;
            scrollPosition -= cardWidth;
            if (scrollPosition < 0) scrollPosition = 0;
            carousel.scrollTo({ left: scrollPosition, behavior: "smooth" });
    });

      // Ejecuta al cargar y al redimensionar pantalla
    updateScrollButtons();
    window.addEventListener("resize", updateScrollButtons);
    });
</script>
<style>
    .parent {
display: grid;
grid-template-columns: repeat(5, 1fr);
grid-column-gap: 11px;
}
.card {
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10px;
  padding: 20px;
}

</style>