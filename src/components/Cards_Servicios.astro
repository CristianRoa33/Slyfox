---
const tarjetas = [
    {   
        imagen: "/src/assets/images/filecode01.webp",
        titulo:"Software a la medida",
        descripcion: " Desarrollo de software personalizado para satisfacer las necesidades únicas de su negocio. desde aplicaciones web hasta soluciones móviles, ofrecemos un enfoque integral para impulsar su éxito digital.",
        items:["Desarrollo Full Stack", "Sistemas Personalizados", "Integraciones con APIs y plataformas"]
    },
    {   
        imagen: "/src/assets/images/dataflow04.webp",
        titulo:"Soluciones Omnicanal",
        descripcion: " Unificar todos tus canales de atención y venta en una sola plataforma. Mejoramos la Experiencia del usuario con herramientas digitales que optimizan la comunicación y automatizan procesos.",
        items:["CRM y Chatbots", "Plataformas de mensajería y redes sociales", "Sincronización de ventas y servicio al cliente"]
    },
    {   
        imagen: "/src/assets/images/currencydollarcircle.webp",
        titulo:"Asesoria en Transformación Digital",
        descripcion: " Te guiamos en el camino hacia la digitación. Optimizamos procesos , mejoramos la experiencia de usuario y te ayudamos a adoptar tecnologías innovadoras para potenciar tu negocio",
        items:["Consultoria en tecnologia y automatización", "Estrategias de escalabilidad y optimización", "Implementación de mejores prácticas."]
    },
    {   
        imagen: "/src/assets/images/pentool01.webp",
        titulo:"Diseño UI/UX",
        descripcion: " Creamos interfaces intuitivas y atractivas que generan impacto.Nos enfocamos en el diseño y la usabilidad para mejorar la interacción de los usuarios con tu plataforma o aplicación.",
        items:["Prototipado y wireframes", "Diseño de interfaces modernas e intuitivas", "Optimización de la experiencia de usuario (UX)"]
    },
    {   
        imagen: "/src/assets/images/fingerprint-03_2x.webp",
        titulo:"Seguridad y Protección de Datos",
        descripcion: " Protege tu información y la de tus clientes con soluciones seguras.Aplicamos medidas avanzadas para garantizar la seguridad en todas tus plataformas.",
        items:["Auditorías de seguridad y vulnerabilidades", "Cifrado de datos y protección conta ataques", "Cumplimiento de Normativas de Seguridad"]
    },
]

const titulo = "Descubre más de tu compañero perfecto."

---
<section class="w-full h-full bg-[#fbfbfb] dark:bg-[#282829] mt-8 xl:mt-40"> 
    <div class= "w-80 p-3 xl:w-160 xl:ml-10">
        <h2 class="text-[#1E1E1E] dark:text-[#ffffffeb] font-satoshi ml-6 p-1 text-base md:mt-15 xl:text-[40px]">
            {titulo}
        </h2>
    </div>
    
<div id="carousel" class="bg-[#fbfbfb] dark:bg-[#282829] flex flex-row gap-1 overflow-auto scrollbar-hide snap-x p-5 transition-transform duration-[10000ms] ease-linear xl:p-5 xl:gap-2 xl:mt-20">
    {tarjetas.map((tarjeta) => (
        <div class="snap-center">
            <div class="bg-[#f5f6f9] dark:bg-[#0D0D0D] flex items-center w-60 h-60 mt-1 ml-1 mr-1 rounded-lg md:h-90 xl:w-90 xl:h-110">
                <img src={tarjeta.imagen} alt={tarjeta.titulo} class="w-30 ml-15 xl:ml-30" /></div>
            <h3 class="text-[#1E1E1E] dark:text-[#ffffffeb] font-satoshi mt-1 ml-5 md:text-[14px] md:font-bold md:ml-2 md:mt-3 xl:text-[22px]">{tarjeta.titulo}</h3>
            <p class="text-[#86868b] dark:text-[#ffffffeb] font-satoshi text-sm p-4 ml-1 md:text-[13px] md:font-bold md:p-2 xl:text-[15px] xl:mb-5">{tarjeta.descripcion}</p>
            <ul class="list-disc pl-5 space-y-2">
                {tarjeta.items.map((item) => (
                    <li class="text-[#1E1E1E] dark:text-[#ffffffeb] font-satoshi text-sm ml-4 md:text-[12px] md:ml-1 xl:text-[15px] ">{item}</li>
                ))}
            </ul>
        </div>
    ))} 
    </div>
        <div class="flex justify-center mt-2 gap-2">
        <button id="prev" class="w-10 bg-gray-800 text-white p-2 rounded-full">
            ❮
        </button>
        <button id="next" class="w-10 bg-gray-800 text-white p-2 rounded-full">
            ❯
        </button>
    </div>

</section>     

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
    const carousel = document.getElementById("carousel");
    const nextBtn = document.getElementById("next");
    const prevBtn = document.getElementById("prev");

    // Define el ancho de cada tarjeta (ajústalo si cambia el diseño)
    const cardWidth = 260; // 240px tarjeta + 20px gap aproximadamente

    let scrollPosition = 0;

    function isMobile() {
    return window.innerWidth < 769;
    }

    function updateScrollButtons() {
        if (isMobile()) {
            nextBtn.style.display = "inline-block";
            prevBtn.style.display = "inline-block";
        } else {
        nextBtn.style.display = "none";
        prevBtn.style.display = "none";
        carousel.scrollTo({ left: 0 }); // Resetea la posición si es necesario
        scrollPosition = 0;
    }
    }
    nextBtn.addEventListener("click", () => {
        if (!isMobile()) return;
            scrollPosition += cardWidth;
            carousel.scrollTo({ left: scrollPosition, behavior: "smooth" });
    });

    prevBtn.addEventListener("click", () => {
        if (!isMobile()) return;
            scrollPosition -= cardWidth;
            if (scrollPosition < 0) scrollPosition = 0;
            carousel.scrollTo({ left: scrollPosition, behavior: "smooth" });
    });

      // Ejecuta al cargar y al redimensionar pantalla
    updateScrollButtons();
    window.addEventListener("resize", updateScrollButtons);
    });
</script>