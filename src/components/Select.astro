---
import { Icon } from "astro-icon/components";

const options = ["Español", "Ingles"];
---

<div class="relative min-w-64">
  <select class="slf-select">
    {
      options.map((option) => (
        <option value={option} class="dark:bg-[#282829]">
          {option}
        </option>
      ))
    }
  </select>

  <div
    class="absolute inset-y-0 right-0 px-2 text-2xl flex items-center pointer-events-none text-[#31323D] dark:text-[#ffffffeb]"
  >
    <Icon name="down-arrow" />
  </div>
</div>

<style>
  @reference "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  .slf-select {
    @apply cursor-pointer w-full px-4 py-2 pr-8 leading-tight text-[#31323D] dark:text-[#ffffffeb]  rounded-xl border-3 border-[#FF7070] dark:border-[#282829] shadow appearance-none focus:outline-none;
  }
</style>
