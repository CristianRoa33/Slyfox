---
import Image from "astro/components/Image.astro";
import Customer1 from "@images/customer1.webp";
import Customer2 from "@images/customer2.webp";
import Customer3 from "@images/customer3.webp";
import Customer4 from "@images/customer4.webp";
import Customer5 from "@images/customer5.webp";
import Star from "@images/Star.png";
import Banner1 from "@images/image130.png"
import Banner2 from "@images/image132.png"
import Banner3 from "@images/image133.png"  
import Banner4 from "@images/image134.png"
import Banner5 from "@images/image135.png"
import Banner6 from "@images/image136.png"

---
<section class="flex flex-col items-center gap-0.5 self-stretch bg-[#fbfbfb] dark:bg-[#282829] h-40 sm:h-50 md:h-60 lg:h-110">
    <h2 class="text-[20px] font-bold font-satoshi pt-5 mt-1 text-center text-[#1E1E1E] dark:text-[#ffffffeb] sm:mt-10 md:text-4xl md:text-center md:mt-20  lg:text-6xl lg:mt-30">Lo hacemos por Ti</h2>
    <div class=" flex justify-center items-center gap-x-6 mt-0 lg:mt-10">
        <div class="flex gap-x-0.5 mt-4 ml-2 sm:mt-8">
            <Image src={Customer1} alt="customer1" class="translate-x-12"/> 
            <Image src={Customer2} alt="customer2" class="translate-x-8"/>
            <Image src={Customer3} alt="customer3" class="translate-x-5"/>
            <Image src={Customer4} alt="customer4" class="translate-x-3"/>
            <Image src={Customer5} alt="customer5" class="translate-x-1"/>
        </div>
        <div class="flex flex-col items-center justify-center mt-0 lg:mt-1">
            <div class="flex gap-x-0.5 mt-4 mr-20 ml-2 sm:mr-28 sm:mt-8 md:ml-2 ">
                <Image src={Star} alt="star" class="w-5 h-5 mt-1"/>
                <Image src={Star} alt="star" class="w-5 h-5 mt-1"/>
                <Image src={Star} alt="star" class="w-5 h-5 mt-1"/>
                <Image src={Star} alt="star" class="w-5 h-5 mt-1"/>
                <Image src={Star} alt="star" class="w-5 h-5 mt-1"/>
            </div>
            <p id="slide" class=" font-satoshi text-center text-[12px] text-[#1E1E1E] dark:text-[#ffffffeb] mt-0 mr-12 sm:text-base md:text-sm md:mr-16 lg:text-[15px] ">Clientes de Confianza</p>
        </div>
</section>
<section class="flex items-center bg-[#fbfbfb] dark:bg-[#282829]">
        <div class="grid ml-10 grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-6 lg:ml-20 lg:mr-20">
            <Image src={Banner1} alt="banner1" class="w-50 h-80 sm:w-80 sm:h-70 md:w-80 md:h-80 md:mr-2 lg:w-100 lg:h-120"/>
            <Image src={Banner2} alt="banner1" class="w-50 h-80 sm:w-80 sm:h-70 md:w-80 md:h-80 md:mr-4 lg:w-100 lg:h-100"/>
            <Image src={Banner3} alt="banner1" class="hidden sm:block sm:h-70 sm:mr-20 md:w-80 md:h-80 md:mr-5 lg:w-100 lg:h-120"/>
            <Image src={Banner4} alt="banner1" class="hidden sm: sm:h-70 md:w-80 md:h-80 md:mr-3 lg:block lg:w-100 lg:h-120"/>
            <Image src={Banner5} alt="banner1" class="hidden sm: md:w-50 md:h-80 lg:block lg:w-100 lg:h-120"/>
            <Image src={Banner6} alt="banner1" class="hidden sm:md:w-50 md:h-80 lg:block lg:w-100 lg:h-120 "/>
        </div>
</section>

<style>
    #slide {
        animation: slide 1s ease-in-out  both;
    }

    @keyframes slide {
    from {
        transform: translatey(100%);
    } to {
        transform: translatey(0);
    }
    }

</style>
