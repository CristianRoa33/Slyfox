---
import Image from "astro/components/Image.astro";
import Star from "../assets/images/Star.png";

const imageCostumer=[
    {src:"/src/assets/images/customer1.webp"  , alt: "customer1", id: "customer1"},
    {src: "/src/assets/images/customer2.webp", alt: "customer2", id: "customer2"},
    {src: "/src/assets/images/customer3.webp", alt: "customer3", id: "customer3"},
    {src: "/src/assets/images/customer4.webp", alt: "customer4", id: "customer4"},
    {src: "/src/assets/images/customer5.webp", alt: "customer5", id: "customer5"}
]
const imagenStar= Array.from({length:5})
---
<section class="flex flex-col items-center gap-0.5 self-stretch bg-[#fbfbfb] dark:bg-[#282829] h-40 sm:h-50 md:h-60 lg:h-120">
    <h2
        class="text-[20px] font-bold font-satoshi pt-5 mt-8 text-center 
        text-[#1E1E1E] dark:text-[#ffffffeb] sm:mt-10 
        md:text-4xl md:text-center md:mt-20  lg:text-6xl lg:mt-30">
        Lo hacemos por Ti
    </h2>
    <div class=" flex justify-center items-center gap-x-5 mt-0 lg:mt-10">
        <div class="flex gap-x-0.5 mt-4 sm:mt-9 sm:ml-20">
            {imageCostumer.map((customer, index)=> (
                <img 
                    src={customer.src} 
                    alt={`customer ${index + 1}`} 
                    id={`customer ${index + 1}`} 
                    class={`w-7 h-7 sm:w-9 sm:h-9 md:w-10 md:h-10 lg:w-11 lg:h-11 xl:w-12 xl:h-12 transform 
                        ${index === 0? 'translate-x-11 animate-customer1':''}
                        ${index === 1? 'translate-x-8 animate-customer2':''}
                        ${index === 2? 'translate-x-5 animate-customer3':''}
                        ${index === 3? 'translate-x-3 animate-customer4':''}
                        ${index === 4? 'translate-x-1 animate-customer5':''} 
                    `} 
                />)
                )
            }
        </div>
    <div class="flex flex-col items-center justify-center mt-0 mr-1 lg:mt-1 ">
        <div 
            id="stars"
            class="flex gap-x-0.5 mt-4 mr-18  sm:mr-31 sm:mt-8 md:ml-2"
        >
            {imagenStar.map((_ , index ) =>(
                <Image 
                    src={Star} 
                    alt={"star" + (index + 1) } 
                    id={"star" + (index + 1) } 
                    class="w-3 h-3 mt-1 xl:w-5 xl:h-5" 
                />
            ))}
    </div>
        <p 
            id="slide" 
            class=" font-satoshi text-end text-[10px] text-[#1E1E1E] dark:text-[#ffffffeb] mt-0 mr-10 
            sm:text-base md:text-sm md:mr-16 lg:text-[15px]">
            Clientes de Confianza
        </p>
    </div>
</section>
<style>
    
    #slide {
        animation: slide-up 1.8s cubic-bezier(.25,.46,.45,.94) both;
    }

    @keyframes slide-up {
    from {
        transform: translatey(200px);
    } to {
        transform: translatey(0);
    }
    }
    
    .animate-customer1 {
    animation: slideIn 1s ease-out forwards;
    }
    .animate-customer2 {
    animation: slideIn 1.2s ease-out forwards;
    }
    .animate-customer3 {
    animation: slideIn 1.4s ease-out forwards;
    }
    .animate-customer4 {
    animation: slideIn 1.6s ease-out forwards;
    }
    .animate-customer5 {
    animation: slideIn 1.8s ease-out forwards;
    }
    .animate-customer6 {
    animation: slideIn 1.10s ease-out forwards;
    }
    
    @keyframes slideIn {
    0% {
    transform: translateX(200px);
    opacity: 0;
    }
    100% {
    transform: translateX(0);
    opacity: 1;
    }
    }

    #star1 {
        animation:pulsate-bck 10s ease-in-out both ;
    }
    #star2 {
        animation:pulsate-bck 8s ease-in-out both ;
    }
    #star3 {
        animation:pulsate-bck 6s ease-in-out both ;
    }
    #star4 {
        animation:pulsate-bck 4s ease-in-out both ;
    }
    #star5 {
        animation:pulsate-bck 2s ease-in-out both ;
    }
    
    @keyframes pulsate-bck {
        0%{opacity:0;} 
        50%{opacity:1;}
        100%{opacity:2;}
    }
</style>

<script>
    window.addEventListener('DOMContentLoaded', ()=> {
        const starsContainer = document.getElementById('stars');
        const starElements= Array.from ({length:5}, (_,index) => 
            document.getElementById(`star${index + 1}`)
        );
        const observer = new IntersectionObserver ((entries)=> {
            entries.forEach((entry )=> {
                if(entry.isIntersecting){
                    starElements.forEach((star,index)=> {
                    star.style.animacion='none';
                    void star.offsetWidth; // Forzar reflujo para reiniciar la animación
                    const durations = [10, 8, 6, 4, 2];
                    star.style.animation = `pulsate-bck ${durations[index]}s ease-in-out both`;
                })
                } else {
                starElements.forEach((star) => {
                    star.style.animation = 'none'; 
                });
            }
    })
} , {
        threshold: 0.4 // El elemento debe estar al menos 40% visible
    })
        if(starsContainer) {
        observer.observe(starsContainer);
    }
    });



</script>