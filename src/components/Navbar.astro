---
import Logo from './Logo.astro';
import DarkMode from './Darkmode.astro';


const links = [
    {name: 'Inicio', href: '/'},
    {name: 'Nuestro Equipo', href: '/about'},
    {name: 'Servicios', href: '/contact'}, 
]
---
<div class="w-full bg-[#fbfbfb] dark:bg-[#282829] md:w-full lg:w-full "></div>
    <nav class="relative w-full h-15 flex flex-row justify-between items-baseline p-2 bg-[#fbfbfb] dark:bg-[#282829] md:w-full md:h-30 md:pl-15 md:flex md:justify-center lg:w-full lg:h-40 lg:flex lg:justify-between ">
        <div class="m-[15px] lg:ms-55"><Logo width="99px"></Logo></div>
        <ul class="hidden md:flex md:flex-row md:justify-evenly md:mr-2 md:gap-5 md:ml-15 md:font-segoe md:text-[#1E1E1E] md:dark:text-[#ffffffeb] lg:flex lg:justify-evenly lg:gap-x-5 lg:font-segoe lg:text-[#1E1E1E] lg:dark:text-[#ffffffeb] lg:ml-3">
            {links.map(link => (
            <li><a href={link.href}>{link.name}</a></li>))}
        </ul>
        <button class="hidden rounded-sm font-segoe text-sm text-[#F5F5F7] bg-[#5137F0] md:flex md:w-22 md:h-8 md:mr-35 md:ml-3.5 md:rounded-lg md:bg-[#5137F0] md:text-[#F5F5F7] md:mt-2 lg:mr-80 lg:items-center">
            <p class=" md:p-2">Conocenos</p>
        </button>
        <div class="absolute transform translate-x-[1px] translate-y-[12px] right-3 top-0 mr-15 mt-2">
            <DarkMode></DarkMode>
        </div>
        <button id="menuButton" class=" flex w-10 h-10 space-y-2 p-2 font-bold  text-[#1E1E1E] dark:text-[#ffffffeb] bg-[#fbfbfb] dark:bg-[#282829] md:hidden lg:hidden  ">
            ☰
        </button>
    </nav>
<div/>   

<style>
    a {
        transition: all 0.5s ease-in-out;
        position: relative;
    }
    a:hover {
        color: #FF7070;
    }
    a::after {
        content: '';
        display: block;
        position: absolute;
        width: 0%;
        height: 2px;
        background: #FF7070;
        transition: all 0.3s ease-in-out;
        scale: 0;
        bottom: -15px;
        
    }
    a:hover::after {
        width: 100%;
        scale: 1;
    }

</style>