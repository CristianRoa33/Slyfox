---
import Select from "./Select.astro";
---

<div class="flex items-center justify-center gap-x-16 bg-[#F5F6FA] dark:bg-[#141414] py-4">
    <span class="text-[#31313D] dark:text-white font-segoe font-normal">
        Elige otro idioma para ver el contenido en tu idioma preferido.
    </span>
    <div class="flex items-center gap-10">
        <Select />
        <button class="flex items-center justify-center h-8 py-1.5 px-5 rounded-sm font-segoe text-sm text-[#F5F5F7] bg-[#FF7070]">
            Continuar
        </button>
    </div>
</div>