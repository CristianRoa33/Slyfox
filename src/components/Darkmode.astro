---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Sun from "@images/sun.webp";
import Moon from "@images/moon.webp";
---

<button id="themeToggle" class="bg-black dark:bg-white  rounded-full w-20 flex">
    <div class="imagen">
        <Image src={Sun} alt="hola" class="dark:hidden" />
        <Image src={Moon} alt="hola" class="hidden dark:inline" />
    </div>
</button>

<style>
    .imagen {
        transform: translateX(0%);
        transition: transform .3s;
    }

    .imagen.isdark{
        transform: translateX(100%);
    }
</style>




<script>
  const toggleDarkMode = (validateMatchMedia: boolean) => {
    
    const HtmlIndexElement = document.getElementById("main-container") as HTMLElement;

    if(!validateMatchMedia) {
        changeDarkModeImage()
        HtmlIndexElement.classList.toggle('dark');
        return
    }

    if(validateMatchMediaDark()) HtmlIndexElement.classList.add('dark'); 
    else HtmlIndexElement.classList.remove('dark');
    changeDarkModeImage()
  };

  const validateMatchMediaDark = () => {
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return true;
    } else { 
        return false;
    }
  }

  const changeDarkModeImage = () => {
    const ImageElement = document.querySelector('.imagen') as HTMLElement;
    const HtmlIndexElement = document.getElementById("main-container") as HTMLElement;

    const darkModeIsActive = HtmlIndexElement.classList.contains('dark')
    if(darkModeIsActive) {
        ImageElement.classList.add('isdark')
    } else {
        ImageElement.classList.remove('isdark')
    }
  }

  toggleDarkMode(true);
  document.getElementById("themeToggle")?.addEventListener("click", () => toggleDarkMode(false));
</script> 