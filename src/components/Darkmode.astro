    <button id="themeToggle" class="flex flex-row relative w-16 h-8 bg-[#E8E7E7] rounded-[15px] cursor-pointer transition-colors duration-300 ease-in-out hover:bg-[ dark:bg-[#141414] dark:hover:bg-[#2C2C2C]">
        <span id=themeIcon class="relative w-7 h-7 translate-x-0  top-1/1transition-transform duration-300 ease-in-out ">
            <img  id="sunIcon" src="/src/assets/images/Mask.png" alt="icon sun" class="flex absolute top-4 left-1 w-full h-full p-[1px] rounded-full transition-opacity duration-300 transform-translate-x-1/2 -translate-y-1/2 opacity-100 bg-[#979797]"/>
            <img id="moonIcon" src="/src/assets/images/moon.webp" alt="icon moon" class="flex absolute top-4 left-3/2 w-full h-full p-[1px] rounded-full transition-opacity duration-300 transform -translate-x-1/2 -translate-y-1/2 opacity-0 bg-[#231f20]"/>
        </span>
    </button>
    
