---

---
    <button id="themeToggle" >
        <span id=themeIcon>
            <img  id="sunIcon" src="/src/assets/images/Mask.png" alt="icon sun"/>
            <img id="moonIcon" src="/src/assets/images/moon.webp" alt="icon moon"/>
        </span>
    </button>
    
    <style>
    #themeToggle {
    width: 64px;
    height: 31px;
    background-color: #E8E7E7;
    border-radius: 15px;
    display: flex;
    cursor: pointer;
    transition: background-color 0.3s ease;
    }
    #themeToggle:hover {
        background-color: rgba(217, 217, 217, 0.10);
    }
    #themeIcon {
        position: relative;
        width: 28px;
        height: 28px
        transform: translate(0%);
        transition: transform 0.3s ease;
    }
    
    #themeIcon img {
        position: absolute;
        display: flex;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        padding: 1px 2px;
        border-radius: 50%;
        transition: opacity 0.3s ease;
        transform: translate(-50%, -50%);
    }

    #themeToggle:hover #themeIcon {
        transform: translate(100%);
    }

    #moonIcon {
        opacity: 0;
        background-color: #231f20;
        outline: 1px dashed #ff7070;
        outline-offset: 8px;
    }

    #sunIcon {
        opacity: 1;
        background-color: #979797;
        outline: 1px dashed #ff7070;
        outline-offset: 8px;
    }

    #themeIcon:hover #sunIcon {
        content: "";
        opacity: 0;
    }

    #themeToggle:hover #moonIcon {
        content: "";
        opacity: 1;
    }

    </style>

<script is:inline>
    const themeIcon = document.getElementById("themeIcon");

    const theme = (()=>{
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    })();
    
    document.documentElement.classList.toggle("dark", theme === "dark");
    themeIcon.src = theme === "dark" ? "/src/assets/images/moon.webp" : "/src/assets/images/sun.webp";

    const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
    
    const isDark= element.classList.contains("dark");
    themeIcon.src = isDark ? "/src/assets/images/moon.webp" : "/src/assets/images/sun.webp";
    
    }
    document.getElementById("themeToggle").addEventListener("click", handleToggleClick);
    
</script>